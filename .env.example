# ==============================================================================
# PARAXIS AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development.
# NEVER commit .env files containing real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PLATFORM RUNTIME & ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
APP_SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_DB=paraxis_dev
POSTGRES_USER=paraxis_user
POSTGRES_PASSWORD=paraxis_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://paraxis_user:paraxis_local_password@localhost:5432/paraxis_dev

# ------------------------------------------------------------------------------
# 3. REDIS (Caching, Session, Pub/Sub & Coordination)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. CORE PLATFORM (Django + DRF)
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings
CORE_PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. INTELLIGENCE PLATFORM (FastAPI + LangGraph)
# ------------------------------------------------------------------------------
INTELLIGENCE_PORT=8001
INTELLIGENCE_HOST=0.0.0.0
INTELLIGENCE_INTERNAL_TOKEN=replace-with-secure-internal-jwt-or-service-secret
CORE_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 6. FRONTEND (Next.js)
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_CORE_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_INTELLIGENCE_API_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# 7. AI & LLM PROVIDER CREDENTIALS (Untrusted at local template stage)
# ------------------------------------------------------------------------------
# Supported providers: google, openai, anthropic, mock
AI_DEFAULT_PROVIDER=google
GOOGLE_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# ------------------------------------------------------------------------------
# 8. OBSERVABILITY & TRACING (OpenTelemetry-compatible)
# ------------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=paraxis-ai-local

# ------------------------------------------------------------------------------
# 9. STORAGE & UPLOADS
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
MEDIA_ROOT=./apps/core/media
STATIC_ROOT=./apps/core/staticfiles

# ------------------------------------------------------------------------------
# 10. NOTIFICATIONS & INTEGRATIONS (Mocked for local dev)
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SLACK_WEBHOOK_URL=
SMS_GATEWAY_API_KEY=
